# RDS / Policy Admin Postgres
PG_HOST=your-rds-endpoint.rds.amazonaws.com
PG_PORT=5432
PG_DB=policy_admin
PG_MASTER_USER=your_master_user
PG_MASTER_PASSWORD=your_master_password
PG_APP_USER=sentinel
PG_APP_PASSWORD=your_app_password

# AWS
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-2
S3_LANDING_BUCKET=sentinel-landing
S3_PROCESSED_BUCKET=sentinel-processed

# Local source data
SOURCE_SYSTEMS_DIR=./source_systems

# Weather API
WEATHER_ZIP_CODES=43215,46201,60601
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive

# Snowflake
SNOWFLAKE_ACCOUNT=your_account
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=SENTINEL_WH
SNOWFLAKE_DATABASE=SENTINEL_DB
SNOWFLAKE_SCHEMA=ANALYTICS
SNOWFLAKE_STAGE=SENTINEL_S3_STAGE
