# RDS / Policy Admin Postgres
PG_HOST=your-rds-endpoint.rds.amazonaws.com
PG_PORT=5432
PG_DB=policy_admin
PG_MASTER_USER=your_master_user
PG_MASTER_PASSWORD=your_master_password
PG_APP_USER=sentinel
# PG_APP_PASSWORD is not provided by AWS, invent any password here yourself.
# scripts/seed_policy_admin_db.py --bootstrap creates the role using this value.
PG_APP_PASSWORD=choose_your_own_password

# AWS
# boto3 reads credentials from ~/.aws/credentials (set up via `aws configure`)
# automatically, these two do not need to be set here. Leave them commented
# out: if uncommented with placeholder values, boto3 will use these literal
# strings instead of your real credentials and every S3 call will fail with
# InvalidAccessKeyId. Only uncomment if you specifically need to override
# the credentials for this project alone.
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION here is not read by boto3 (boto3 uses AWS_DEFAULT_REGION, or
# the region set via `aws configure` in ~/.aws/config). This value is kept
# here for reference only; the actual region used by extractors is whatever
# `aws configure get region` returns. Keep them in sync manually.
AWS_REGION=us-east-2
S3_LANDING_BUCKET=sentinel-landing
S3_PROCESSED_BUCKET=sentinel-processed

# Local source data
SOURCE_SYSTEMS_DIR=./source_systems

# Weather API
WEATHER_ZIP_CODES=43215,46201,60601
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive

# Snowflake
SNOWFLAKE_ACCOUNT=your_account
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=SENTINEL_WH
SNOWFLAKE_DATABASE=SENTINEL_DB
SNOWFLAKE_SCHEMA=ANALYTICS
SNOWFLAKE_STAGE=SENTINEL_S3_STAGE

# Airflow web UI (docker-compose.airflow.yml), not provided by AWS/Snowflake,
# invent these yourself. Only takes effect on the container's first run,
# see docs/airflow_setup.md if you need to reset it later.
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=choose_your_own_password
